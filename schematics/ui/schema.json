{
  "$schema": "http://json-schema.org/schema",
  "$id": "IdsUi",
  "title": "IDS UI (presentational component) Options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name (e.g. kit-card).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What is the component name?"
    },
    "path": {
      "type": "string",
      "description": "Target folder.",
      "default": "projects/app/src/app/shared/components"
    }
  },
  "required": ["name"]
}
