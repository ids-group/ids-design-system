{
  "$schema": "http://json-schema.org/schema",
  "$id": "IdsDataAccess",
  "title": "IDS Data Access (API class) Options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Entity name (e.g. kit).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What is the entity name?"
    },
    "path": {
      "type": "string",
      "description": "Target folder.",
      "default": "projects/app/src/app/core/api"
    }
  },
  "required": ["name"]
}
