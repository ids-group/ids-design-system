{
  "$schema": "http://json-schema.org/schema",
  "$id": "IdsFeature",
  "title": "IDS Feature Options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Feature name (e.g. kit-movement).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What is the feature name?"
    },
    "path": {
      "type": "string",
      "description": "Path to the app's features folder.",
      "default": "projects/app/src/app/features"
    }
  },
  "required": ["name"]
}
