{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "../..",
    "types": [],
    "baseUrl": "../..",
    "paths": {
      "@ids-group-ltd/ids-design-system": ["./src/lib/public-api.ts"],
      "@ids-group-ltd/ids-design-system/*": ["./src/lib/*", "./src/lib/components/*"]
    }
  },
  "include": ["gen/wrappers.tsx", "gen/index.ts", "runtime.tsx"]
}
