{
  "projectId": "455f9a87-1a6e-4b1d-a0e7-cf47ed772e63",
  "shape": "package",
  "pkg": "@ids-group-ltd/ids-design-system",
  "globalName": "IdsDs",
  "entry": ".design-sync/elements/dist/ds-bundle.js",
  "cssEntry": "dist/ds-bundle.css",
  "docsDir": "../docs",
  "readmeHeader": ".design-sync/conventions.md",
  "sections": {
    "AccordionItem": "components/accordion",
    "AvatarGroup": "components/avatar",
    "ButtonGroup": "components/button",
    "CalendarDay": "components/date-picker",
    "Container": "components/layout-primitives",
    "DescriptionItem": "components/description-list",
    "Divider": "foundations/borders",
    "FieldMessage": "components/input",
    "Inline": "components/layout-primitives",
    "ListItem": "components/list",
    "MenuDivider": "components/menu",
    "MenuItem": "components/menu",
    "ModalCard": "components/modal",
    "ModalConfirm": "components/modal",
    "RadioGroup": "components/radio",
    "SidenavFooter": "components/sidenav",
    "SidenavGroup": "components/sidenav",
    "SidenavItem": "components/sidenav",
    "Stack": "components/layout-primitives",
    "Tab": "components/tabs",
    "TimeColumns": "components/time-picker",
    "TimelineItem": "components/timeline",
    "ToastRegion": "components/toast",
    "ToggleButton": "components/button",
    "TooltipPanel": "components/tooltip"
  },
  "overrides": {
    "Button": { "replaces": ["button"] },
    "Checkbox": { "replaces": ["input[type=checkbox]"] },
    "Input": { "replaces": ["input"] },
    "List": { "replaces": ["ul"] },
    "Modal": { "replaces": ["dialog"] },
    "Radio": { "replaces": ["input[type=radio]"] },
    "Select": { "replaces": ["select"] },
    "Slider": { "replaces": ["input[type=range]"] },
    "Table": { "replaces": ["table"] },
    "Textarea": { "replaces": ["textarea"] }
  },
  "buildCmd": "node .design-sync/elements/tools/gen.mjs && npx ng build ds-elements && node .design-sync/elements/tools/build-bundle.mjs"
}
