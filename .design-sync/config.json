{
  "projectId": "455f9a87-1a6e-4b1d-a0e7-cf47ed772e63",
  "shape": "package",
  "pkg": "@ids-group-ltd/ids-design-system",
  "globalName": "IdsDs",
  "entry": ".design-sync/elements/dist/ds-bundle.js",
  "cssEntry": "dist/ds-bundle.css",
  "docsDir": "../docs",
  "readmeHeader": ".design-sync/conventions.md",
  "thumbnailCard": "components/actions/Button/Button-Color-variant.html",
  "sections": {
    "AccordionItem": "components/accordion",
    "AvatarGroup": "components/avatar",
    "BarChart": "charts",
    "ButtonGroup": "components/segmented",
    "CalendarDay": "components/date-picker",
    "Chart": "charts/chart",
    "ChartDataTable": "charts/chart",
    "ChartLegend": "charts/line-chart",
    "ChartSkeleton": "charts/chart",
    "ChartTooltipPanel": "charts/line-chart",
    "ChartUnpin": "charts/chart",
    "ColumnChart": "charts/column-chart",
    "Container": "components/layout-primitives",
    "DescriptionItem": "components/description-list",
    "Divider": "foundations/borders",
    "FieldMessage": "components/input",
    "FieldStatus": "practice/signal-forms",
    "FunnelChart": "charts/funnel-chart",
    "HeatmapChart": "charts/heatmap-chart",
    "InfoHint": "components/tooltip",
    "Inline": "components/layout-primitives",
    "LineChart": "charts/line-chart",
    "ListItem": "components/list",
    "MenuDivider": "components/menu",
    "MenuItem": "components/menu",
    "ModalCard": "components/modal",
    "ModalConfirm": "components/modal",
    "PieChart": "charts/pie-chart",
    "RadioGroup": "components/radio",
    "ScatterChart": "charts/scatter-chart",
    "SidenavFooter": "components/app-layout",
    "SidenavGroup": "components/sidenav",
    "SidenavItem": "components/sidenav",
    "Sparkline": "charts/sparkline",
    "Stack": "components/layout-primitives",
    "Tab": "components/tabs",
    "TimeColumns": "components/time-picker",
    "TimelineItem": "components/timeline",
    "ToastRegion": "components/toast",
    "ToggleButton": "components/button",
    "TooltipPanel": "components/tooltip",
    "WaterfallChart": "charts/waterfall-chart"
  },
  "overrides": {
    "Button": {
      "replaces": [
        "button"
      ]
    },
    "Checkbox": {
      "replaces": [
        "input[type=checkbox]"
      ]
    },
    "Input": {
      "replaces": [
        "input"
      ]
    },
    "List": {
      "replaces": [
        "ul"
      ]
    },
    "Modal": {
      "replaces": [
        "dialog"
      ]
    },
    "Radio": {
      "replaces": [
        "input[type=radio]"
      ]
    },
    "Select": {
      "replaces": [
        "select"
      ]
    },
    "Slider": {
      "replaces": [
        "input[type=range]"
      ]
    },
    "Table": {
      "replaces": [
        "table"
      ]
    },
    "Textarea": {
      "replaces": [
        "textarea"
      ]
    }
  },
  "buildCmd": "node .design-sync/elements/tools/gen.mjs && npx ng build ds-elements && node .design-sync/elements/tools/build-bundle.mjs"
}
