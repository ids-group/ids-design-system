{
  "projectId": "455f9a87-1a6e-4b1d-a0e7-cf47ed772e63",
  "shape": "package",
  "pkg": "@ids-group-ltd/ids-design-system",
  "globalName": "IdsDs",
  "entry": ".design-sync/elements/dist/ds-bundle.js",
  "cssEntry": "dist/ds-bundle.css",
  "docsDir": "../docs",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Button": {
      "replaces": ["button"]
    },
    "Checkbox": {
      "replaces": ["input[type=checkbox]"]
    },
    "Input": {
      "replaces": ["input"]
    },
    "List": {
      "replaces": ["ul"]
    },
    "Radio": {
      "replaces": ["input[type=radio]"]
    },
    "Select": {
      "replaces": ["select"]
    },
    "Icon": {
      "cardMode": "column"
    },
    "EmptyState": {
      "cardMode": "column"
    },
    "LoadingOverlay": {
      "cardMode": "column"
    },
    "Progress": {
      "cardMode": "column"
    },
    "RadioGroup": {
      "cardMode": "column"
    },
    "Search": {
      "cardMode": "column"
    },
    "Textarea": {
      "cardMode": "column",
      "replaces": ["textarea"]
    },
    "Table": {
      "cardMode": "column",
      "replaces": ["table"]
    },
    "Timeline": {
      "cardMode": "column"
    },
    "Alert": {
      "cardMode": "column"
    },
    "Banner": {
      "cardMode": "column"
    },
    "Autocomplete": {
      "cardMode": "column"
    },
    "MultiSelect": {
      "cardMode": "column"
    },
    "OtpInput": {
      "cardMode": "column"
    },
    "Slider": {
      "cardMode": "column",
      "replaces": ["input[type=range]"]
    },
    "Menu": {
      "cardMode": "column"
    },
    "Stepper": {
      "cardMode": "column"
    },
    "Tabs": {
      "cardMode": "column"
    },
    "PageHeader": {
      "cardMode": "column"
    },
    "PageFooter": {
      "cardMode": "column"
    },
    "DatePicker": {
      "cardMode": "column"
    },
    "TimePicker": {
      "cardMode": "column"
    },
    "Modal": {
      "cardMode": "column",
      "replaces": ["dialog"]
    },
    "ModalCard": {
      "cardMode": "column"
    },
    "ModalConfirm": {
      "cardMode": "column"
    },
    "Drawer": {
      "cardMode": "column"
    },
    "AppLayout": {
      "cardMode": "column",
      "primaryStory": "FullShell"
    },
    "Topbar": {
      "cardMode": "column"
    },
    "AuthLayout": {
      "cardMode": "column"
    },
    "FieldGroup": {
      "cardMode": "column"
    },
    "FieldMessage": {
      "cardMode": "column"
    },
    "FilterBar": {
      "cardMode": "column"
    },
    "PasswordRules": {
      "cardMode": "column"
    }
  },
  "buildCmd": "node .design-sync/elements/tools/gen.mjs && npx ng build ds-elements && node .design-sync/elements/tools/build-bundle.mjs"
}
