    "Search": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "Table": { "cardMode": "column" },
    "Timeline": { "cardMode": "column" },
    "Alert": { "cardMode": "column" },
    "Banner": { "cardMode": "column" },
    "Autocomplete": { "cardMode": "column" },
    "MultiSelect": { "cardMode": "column" },
    "OtpInput": { "cardMode": "column" },
    "Slider": { "cardMode": "column" },
    "Menu": { "cardMode": "column" },
    "Stepper": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Tooltip": { "cardMode": "column" },
