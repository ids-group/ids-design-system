{
  "allow": {
    "Dropzone": {
      "onFilesChange": "upstream `files` is a model the component mutates; the binding takes `files` read-only and reports picks through `onFilesAdded` so a preview can render a fixed file list"
    },
    "Modal": {
      "onConfirmed": "upstream never emits `confirmed` itself — the consumer's own confirm action does; in React that is an onClick inside the `actions` slot"
    },
    "Pagination": {
      "onCurrentPageChange": "the `currentPage` model and the `pageChange` output are the same event upstream (see the pagination dedup item in docs/todo.md) — ported once as `onPageChange`"
    },
    "SidenavItem": {
      "routerLink": "Angular router is runtime-only and out of scope for a static design — navigation is surfaced as `onNavigate`"
    },
    "Table": {
      "onSortKeyChange": "sortKey/sortDir are one user action — ported as a single `onSortChange({ key, dir })`",
      "onSortDirChange": "sortKey/sortDir are one user action — ported as a single `onSortChange({ key, dir })`",
      "onColumnFiltersChange": "the set-filter popover UI is not ported (only its trigger renders), so nothing in the binding can change it — the prop seeds a static state",
      "onHiddenKeysChange": "the column-picker popover UI is not ported, so nothing in the binding can change it — the prop seeds a static state",
      "onColumnWidthsChange": "drag-resize is not ported (pointer-driven, runtime-only) — the prop seeds a static state",
      "onColumnOrderChange": "drag-reorder is not ported (pointer-driven, runtime-only) — the prop seeds a static state",
      "onRowActionSelected": "the row-action kebab menu is not ported (only the trigger column renders)",
      "cellTemplateMap": "TemplateRef input — the React stand-in is `cellTemplates` (keyed render functions)",
      "emptyTemplate": "TemplateRef input — the React stand-in is the `empty` node prop",
      "rowExpandTemplate": "TemplateRef input — the React stand-in is `renderRowExpand`"
    }
  },
