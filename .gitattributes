# Every text file is stored LF and checked out LF, whatever a contributor sets locally.
# The five rules below were each added after this bit someone; this line closes the class,
# because relying on core.autocrlf makes the stored form depend on who ran the commit.
# Binaries are named explicitly rather than left to content detection.
* text=auto eol=lf
*.png binary
*.ico binary
*.woff2 binary
*.jpg binary
*.pdf binary

# Shell scripts must stay LF — CRLF breaks them on the alpine CI runner
# (`/bin/sh^M: bad interpreter`), regardless of a contributor's core.autocrlf.
*.sh text eol=lf

# Generated docs data is emitted with LF by the extractors; pin eol=lf so it
# doesn't churn to CRLF on every build under core.autocrlf.
*.generated.ts text eol=lf

# Same reason for the agent catalogue: split-agent-catalogue.mjs writes LF, so without
# this every build:docs reports 60 modified files that differ only in line endings — and
# that churn sweeps into whichever commit runs next.
agent/** text eol=lf

# docs/todo.md was stored verbatim as CRLF (git read it as binary) and picked up 23
# doubled carriage returns from a tool writing CRLF into an already-CRLF file.
# Pinning eol=lf keeps it LF in the worktree too, so no conversion step is left to
# double, and the file diffs and merges like every other doc.
docs/todo.md text eol=lf
# A whole-file diff hides the real change and buries it in review. An edit that preserves
# the working copy CRLF can land as a CRLF blob where the history is LF, rewriting every line.
CHANGELOG.md text eol=lf
