{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app",
    "build": "ng build app",
    "watch": "ng build app --watch --configuration development",
    "lint": "eslint \"projects/**/*.{ts,html}\"",
    "lint:fix": "eslint \"projects/**/*.{ts,html}\" --fix",
    "lint:styles": "stylelint \"projects/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint \"projects/**/*.{scss,css}\" --fix",
    "format": "prettier --check \"projects/**/*.{ts,html,scss,css,json,md}\"",
    "format:fix": "prettier --write \"projects/**/*.{ts,html,scss,css,json,md}\"",
    "lint:all": "bun run format && bun run lint:styles && bun run lint",
    "lint:all:fix": "bun run format:fix && bun run lint:styles:fix && bun run lint:fix"
  },
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ids-group-ltd/ids-design-system": "file:../dist/ds",
    "@ngrx/signals": "^21.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "lefthook": "^2.1.1",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0"
  }
}
