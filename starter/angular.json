{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "bun",
    "analytics": false,
    "cache": {
      "enabled": true,
      "environment": "all"
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush",
      "standalone": true
    },
    "@schematics/angular:directive": { "standalone": true },
    "@schematics/angular:pipe": { "standalone": true }
  },
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "root": "projects/app",
      "sourceRoot": "projects/app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/app/src/main.ts",
            "tsConfig": "projects/app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "projects/app/public" }],
            "styles": ["projects/app/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/common/styles"]
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": true },
                "fonts": true
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "sourceMap": { "scripts": true, "hidden": true },
              "fileReplacements": [
                {
                  "replace": "projects/common/config/src/environments/environment.ts",
                  "with": "projects/common/config/src/environments/environment.prod.ts"
                },
                {
                  "replace": "projects/common/dev/src/public-api.ts",
                  "with": "projects/common/dev/src/public-api.prod.ts"
                }
              ]
            },
            "staging": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": true },
                "fonts": true
              },
              "budgets": [
                { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "sourceMap": { "scripts": true, "hidden": true },
              "fileReplacements": [
                {
                  "replace": "projects/common/config/src/environments/environment.ts",
                  "with": "projects/common/config/src/environments/environment.staging.ts"
                },
                {
                  "replace": "projects/common/dev/src/public-api.ts",
                  "with": "projects/common/dev/src/public-api.prod.ts"
                }
              ]
            },
            "uat": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "sourceMap": { "scripts": true, "hidden": true },
              "fileReplacements": [
                {
                  "replace": "projects/common/config/src/environments/environment.ts",
                  "with": "projects/common/config/src/environments/environment.uat.ts"
                },
                {
                  "replace": "projects/common/dev/src/public-api.ts",
                  "with": "projects/common/dev/src/public-api.prod.ts"
                }
              ]
            },
            "test": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "namedChunks": true,
              "sourceMap": { "scripts": true, "hidden": true },
              "fileReplacements": [
                {
                  "replace": "projects/common/config/src/environments/environment.ts",
                  "with": "projects/common/config/src/environments/environment.test.ts"
                }
              ]
            },
            "prototype": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2.5MB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "sourceMap": { "scripts": true, "hidden": true },
              "fileReplacements": [
                {
                  "replace": "projects/common/config/src/environments/environment.ts",
                  "with": "projects/common/config/src/environments/environment.prototype.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "app:build:production" },
            "staging": { "buildTarget": "app:build:staging" },
            "uat": { "buildTarget": "app:build:uat" },
            "test": { "buildTarget": "app:build:test" },
            "prototype": { "buildTarget": "app:build:prototype" },
            "development": { "buildTarget": "app:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "common": {
      "projectType": "library",
      "root": "projects/common",
      "sourceRoot": "projects/common/src",
      "prefix": "app",
      "architect": {}
    }
  }
}
