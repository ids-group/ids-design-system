{
  "name": "@ids-group-ltd/ids-design-system",
  "version": "0.1.0",
  "description": "IDS Group Angular design system: components, tokens, themes",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/itband/ids-design-system.git"
  },
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "ids-group"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "ng": "ng",
    "prepublishOnly": "node -e \"console.error('Publish from dist/ds (npm publish ./dist/ds), not the repo root.'); process.exit(1)\"",
    "release:patch": "npm version patch -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\"",
    "publish:manual": "npm run build && npm publish ./dist/ds",
    "build": "ng build ds",
    "build:dev": "ng build ds --configuration development",
    "watch": "ng build ds --watch --configuration development",
    "start": "ng serve ds-docs",
    "serve:docs": "ng serve ds-docs",
    "build:docs": "ng build ds-docs",
    "build:docs:dev": "ng build ds-docs --configuration development",
    "lint": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\"",
    "lint:fix": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\" --fix",
    "lint:styles": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\" --fix",
    "format": "prettier --check \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "format:fix": "prettier --write \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "lint:all": "npm run format && npm run lint:styles && npm run lint"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ng-packagr": "^21.2.0",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.2",
    "zone.js": "~0.15.0",
    "@eslint/js": "^9.39.2",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.56.0"
  },
  "sideEffects": false
}
