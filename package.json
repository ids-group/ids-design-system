{
  "name": "@ids-group-ltd/ids-design-system",
  "version": "0.12.3",
  "description": "IDS Group Angular design system: components, tokens, themes",
  "license": "MIT",
  "homepage": "https://ids-ds.proto.ids-group.co.uk/",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "ids-group"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./themes/*": "./themes/*",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "agent-catalogue": "node tools/split-agent-catalogue.mjs",
    "build:deck-css": "node tools/build-deck-css.mjs",
    "build:docs": "npm run extract-docs && ng build ds-docs",
    "build:docs:dev": "npm run extract-docs && ng build ds-docs --configuration development",
    "build:elements": "node .design-sync/elements/tools/gen.mjs && ng build ds-elements && node .design-sync/elements/tools/build-bundle.mjs",
    "build:upload": "node .design-sync/tools/build-upload.mjs",
    "build:lib": "npm run sync-lib-package && ng build ds && node tools/add-entry-aliases.mjs && node tools/build-schematics.mjs",
    "entry-aliases": "node tools/add-entry-aliases.mjs",
    "sync-lib-package": "node tools/sync-lib-package.mjs",
    "check:chart-palette": "node tools/generate-chart-palette.mjs --check",
    "check:lib-package": "node tools/sync-lib-package.mjs --check",
    "build:lib:dev": "npm run sync-lib-package && ng build ds --configuration development",
    "build:schematics": "node tools/build-schematics.mjs",
    "changelog-lint": "node tools/changelog-lint.mjs",
    "changelog-lint:selftest": "node tools/changelog-lint-selftest.mjs",
    "check-class-surface-entry": "node tools/check-class-surface-entry.mjs",
    "check-color-families": "node tools/check-color-families.mjs",
    "check-delete-tables": "node tools/check-delete-tables.mjs",
    "check-design-sync-log": "node tools/check-design-sync-log.mjs",
    "check-docblock-drift": "node tools/check-docblock-drift.mjs",
    "check-docs-attrs": "node tools/check-docs-attrs.mjs",
    "check-docs-links": "node tools/check-docs-links.mjs",
    "check-entry-point-imports": "node tools/check-entry-point-imports.mjs",
    "check-focus-rings": "node tools/check-focus-rings.mjs",
    "check-manifest-coverage": "node tools/check-manifest-coverage.mjs",
    "check-manifest-truth": "node tools/check-manifest-truth.mjs",
    "check-manifest-truth:selftest": "node tools/check-manifest-truth-selftest.mjs",
    "check-void-tokens": "node tools/check-void-tokens.mjs",
    "check-void-tokens:selftest": "node tools/check-void-tokens-selftest.mjs",
    "check-manifest-coverage:audit": "node tools/check-manifest-coverage.mjs --audit",
    "check-manifest-coverage:selftest": "node tools/check-manifest-coverage-selftest.mjs",
    "check-tools-parse": "node tools/check-tools-parse.mjs",
    "check:agent-catalogue": "node tools/split-agent-catalogue.mjs --check",
    "check:manual-surface": "node .design-sync/tools/check-manual-surface.mjs",
    "design-sync-plan": "node tools/design-sync-upload-plan.mjs",
    "design-sync-plan:record": "node tools/design-sync-upload-plan.mjs --record",
    "todo-index": "node tools/todo-index.mjs",
    "todo-index:check": "node tools/todo-index.mjs --check",
    "class-surface": "node tools/class-surface-diff.mjs",
    "deck-lint": "node tools/deck-lint.mjs",
    "deck-lint:selftest": "node tools/deck-lint-selftest.mjs",
    "dev": "npm run start",
    "dev:docs": "npm run extract-docs && ng serve ds-docs --port 4300",
    "extract-component-api": "node tools/extract-component-api.mjs",
    "extract-docs": "npm run extract-tokens && npm run generate-chart-palette && npm run extract-component-api && npm run agent-catalogue && npm run check-docs-links",
    "extract-tokens": "node tools/extract-tokens.mjs",
    "generate-chart-palette": "node tools/generate-chart-palette.mjs",
    "fix:all": "run-s -c format:fix lint:styles:fix lint:fix",
    "format": "prettier --check \"{src,ds-docs/src,tools}/**/*.{ts,json,md}\"",
    "format:records": "prettier --write --ignore-path .prettierignore-none CHANGELOG.md \"migrations/*.json\"",
    "format:fix": "prettier --write \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "lint": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\"",
    "lint:all": "run-s -c check-tools-parse check-entry-point-imports check:lib-package check:chart-palette probes format lint:styles check-focus-rings check-color-families check-docblock-drift changelog-lint check-manifest-coverage check-design-sync-log check-docs-attrs check-void-tokens deck-lint lint",
    "lint:fix": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\" --fix",
    "lint:styles": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\" --fix",
    "migration-lint": "node tools/migration-lint.mjs",
    "migration-lint:selftest": "node tools/migration-lint-selftest.mjs",
    "ng": "ng",
    "picker-capabilities": "node tools/picker-capabilities.mjs",
    "picker-parity": "node tools/picker-parity.mjs",
    "prepublishOnly": "node -e \"console.error('Publish from dist/ds (npm publish ./dist/ds), not the repo root.'); process.exit(1)\"",
    "preversion": "node tools/preflight.mjs",
    "probes": "run-s -c probe:bar-chart-math probe:charts-format probe:charts-scale probe:charts-summary",
    "probe:bar-chart-math": "node --experimental-strip-types tools/probes/bar-chart-math.probe.mjs",
    "probe:charts-format": "node --experimental-strip-types tools/probes/charts-format.probe.mjs",
    "probe:charts-scale": "node --experimental-strip-types tools/probes/charts-scale.probe.mjs",
    "probe:charts-summary": "node --experimental-strip-types tools/probes/charts-summary.probe.mjs",
    "publish:manual": "npm run build:lib && npm publish ./dist/ds",
    "release:beta": "npm version prerelease --preid=beta -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:patch": "npm version patch -m \"release: %s\"",
    "start": "npm run dev:docs",
    "version": "node tools/prepare-release-commit.mjs",
    "watch": "ng build ds --watch --configuration development"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "marked": "^18.0.5",
    "ng-packagr": "^21.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "sass": "1.97.3",
    "stylelint": "^17.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "zone.js": "~0.15.0"
  },
  "sideEffects": false
}
