{
  "name": "@ids-group-ltd/ids-design-system",
  "version": "0.10.3",
  "description": "IDS Group Angular design system: components, tokens, themes",
  "license": "MIT",
  "homepage": "https://ids-ds.proto.ids-group.co.uk/",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "ids-group"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run dev:docs",
    "dev": "npm run start",
    "dev:docs": "npm run extract-docs && ng serve ds-docs --port 4300",
    "watch": "ng build ds --watch --configuration development",
    "build:lib": "ng build ds && node tools/build-schematics.mjs",
    "build:lib:dev": "ng build ds --configuration development",
    "build:schematics": "node tools/build-schematics.mjs",
    "extract-tokens": "node tools/extract-tokens.mjs",
    "extract-component-api": "node tools/extract-component-api.mjs",
    "class-surface": "node tools/class-surface-diff.mjs",
    "check-docs-links": "node tools/check-docs-links.mjs",
    "migration-lint": "node tools/migration-lint.mjs",
    "check-focus-rings": "node tools/check-focus-rings.mjs",
    "extract-docs": "npm run extract-tokens && npm run extract-component-api && npm run check-docs-links",
    "build:docs": "npm run extract-docs && ng build ds-docs",
    "build:docs:dev": "npm run extract-docs && ng build ds-docs --configuration development",
    "build:deck-css": "node tools/build-deck-css.mjs",
    "format": "prettier --check \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "format:fix": "prettier --write \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "lint": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\"",
    "lint:fix": "eslint \"{src,ds-docs/src}/**/*.{ts,html}\" --fix",
    "lint:styles": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint \"{src,ds-docs/src}/**/*.{scss,css}\" --fix",
    "lint:all": "run-s -c format lint:styles check-focus-rings lint",
    "fix:all": "run-s -c format:fix lint:styles:fix lint:fix",
    "preversion": "node tools/preflight.mjs",
    "version": "node tools/changelog-release.mjs",
    "release:patch": "npm version patch -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\"",
    "release:beta": "npm version prerelease --preid=beta -m \"release: %s\"",
    "prepublishOnly": "node -e \"console.error('Publish from dist/ds (npm publish ./dist/ds), not the repo root.'); process.exit(1)\"",
    "publish:manual": "npm run build:lib && npm publish ./dist/ds"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "marked": "^18.0.5",
    "ng-packagr": "^21.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "stylelint": "^17.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "zone.js": "~0.15.0"
  },
  "sideEffects": false
}
