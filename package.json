{
  "name": "@ids-group-ltd/ds",
  "version": "0.1.0",
  "description": "IDS Group Angular design system: components, tokens, themes",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/itband/ids-design-system.git"
  },
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "ids-group"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "ng": "ng",
    "prepublishOnly": "node -e \"console.error('Publish from dist/ds (npm publish dist/ds), not the repo root.'); process.exit(1)\"",
    "release:patch": "npm version patch && npm run release:publish",
    "release:minor": "npm version minor && npm run release:publish",
    "release:major": "npm version major && npm run release:publish",
    "release:publish": "npm run build && npm publish dist/ds && git push --follow-tags",
    "build": "ng build ds",
    "build:dev": "ng build ds --configuration development",
    "watch": "ng build ds --watch --configuration development",
    "start": "ng serve ds-docs",
    "serve:docs": "ng serve ds-docs",
    "build:docs": "ng build ds-docs",
    "build:docs:dev": "ng build ds-docs --configuration development",
    "build:showcase": "ng build ds-docs --configuration showcase && node tools/showcase/inline.mjs",
    "test:showcase": "node --test \"tools/showcase/*.test.mjs\""
  },
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ng-packagr": "^21.2.0",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.2",
    "zone.js": "~0.15.0"
  },
  "sideEffects": false
}
