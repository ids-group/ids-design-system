{
  "name": "@ids-group-ltd/ids-design-system",
  "version": "1.0.2",
  "description": "IDS Group Angular design system: components, tokens, themes",
  "license": "MIT",
  "homepage": "https://ids-ds.proto.ids-group.co.uk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ids-group/ids-design-system.git"
  },
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui",
    "ids-group"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles/*": "./styles/*",
    "./themes/*": "./themes/*",
    "./migrations/*": "./migrations/*",
    "./stylelint": "./stylelint/index.mjs",
    "./eslint": "./eslint/index.mjs"
  },
  "scripts": {
    "agent-catalogue": "node tools/split-agent-catalogue.mjs",
    "build:docs": "npm run extract-docs && ng build ds-docs",
    "build:docs:dev": "npm run extract-docs && ng build ds-docs --configuration development",
    "build:elements": "node .design-sync/elements/tools/gen.mjs && ng build ds-elements && node .design-sync/elements/tools/build-bundle.mjs",
    "build:upload": "node .design-sync/tools/build-upload.mjs",
    "build:lib": "npm run sync-lib-package && ng build ds && node tools/sync-lib-package.mjs --dist && node tools/add-entry-aliases.mjs && node tools/build-schematics.mjs",
    "entry-aliases": "node tools/add-entry-aliases.mjs",
    "sync-lib-package": "node tools/sync-lib-package.mjs",
    "build:lib:dev": "npm run sync-lib-package && ng build ds --configuration development",
    "build:schematics": "node tools/build-schematics.mjs",
    "check": "node tools/check.mjs",
    "check:lint": "node tools/check.mjs --group lint --keep-going",
    "check:release": "node tools/check.mjs --group release",
    "check:selftests": "node tools/check.mjs --group selftests --keep-going",
    "check:cards": "node .design-sync/tools/bootstrap.mjs && npm run build:elements && node tools/check.mjs manual-surface && node .design-sync/tools/check-doc-api.mjs",
    "design-sync-plan": "node tools/design-sync-upload-plan.mjs",
    "design-sync-plan:record": "node tools/design-sync-upload-plan.mjs --record",
    "todo-index": "node tools/todo-index.mjs",
    "class-surface": "node tools/class-surface-diff.mjs",
    "dev": "npm run start",
    "dev:docs": "npm run extract-docs && ng serve ds-docs --port 4300",
    "extract-component-api": "node tools/extract-component-api.mjs",
    "input-lists": "node tools/generate-input-lists.mjs",
    "extract-docs": "npm run extract-tokens && npm run extract-statuses && npm run generate-chart-palette && npm run generate-public-api && npm run extract-component-api && npm run input-lists && npm run agent-catalogue && node tools/check.mjs docs-links",
    "extract-tokens": "node tools/extract-tokens.mjs",
    "extract-statuses": "node tools/extract-statuses.mjs",
    "generate-chart-palette": "node tools/generate-chart-palette.mjs",
    "generate-public-api": "node tools/generate-public-api.mjs",
    "fix:all": "run-s -c format:fix lint:styles:fix lint:fix",
    "format": "prettier --check \"{src,ds-docs/src,tools}/**/*.{ts,json,md}\"",
    "format:fix": "prettier --write \"{src,ds-docs/src,tools}/**/*.{ts,html,scss,css,json,md}\"",
    "lint": "eslint --cache --cache-location .cache/eslint/ \"{src,ds-docs/src}/**/*.{ts,html}\"",
    "lint:all": "run-s -c check:lint format lint:styles lint",
    "lint:fix": "eslint --cache --cache-location .cache/eslint/ \"{src,ds-docs/src}/**/*.{ts,html}\" --fix",
    "lint:styles": "stylelint --cache --cache-location .cache/stylelint/ \"{src,ds-docs/src}/**/*.{scss,css}\"",
    "lint:styles:fix": "stylelint --cache --cache-location .cache/stylelint/ \"{src,ds-docs/src}/**/*.{scss,css}\" --fix",
    "ng": "ng",
    "picker-capabilities": "node tools/picker-capabilities.mjs",
    "picker-parity": "node tools/picker-parity.mjs",
    "prepublishOnly": "node -e \"console.error('Publish from dist/ds (npm publish ./dist/ds), not the repo root.'); process.exit(1)\"",
    "preversion": "node tools/preflight.mjs",
    "probes": "node tools/run-probes.mjs",
    "probe:pie-chart-math": "node --experimental-strip-types tools/probes/pie-chart-math.probe.mjs",
    "probe:funnel-chart-math": "node --experimental-strip-types tools/probes/funnel-chart-math.probe.mjs",
    "probe:heatmap-chart-math": "node --experimental-strip-types tools/probes/heatmap-chart-math.probe.mjs",
    "probe:scatter-chart-math": "node --experimental-strip-types tools/probes/scatter-chart-math.probe.mjs",
    "probe:dropzone-files": "node --experimental-strip-types tools/probes/dropzone-files.probe.mjs",
    "probe:charts-decimate": "node --experimental-strip-types tools/probes/charts-decimate.probe.mjs",
    "probe:charts-label-fit": "node --experimental-strip-types tools/probes/charts-label-fit.probe.mjs",
    "probe:waterfall-chart-math": "node --experimental-strip-types tools/probes/waterfall-chart-math.probe.mjs",
    "probe:line-chart-math": "node --experimental-strip-types tools/probes/line-chart-math.probe.mjs",
    "probe:bar-chart-math": "node --experimental-strip-types tools/probes/bar-chart-math.probe.mjs",
    "probe:chart-math": "node --experimental-strip-types tools/probes/chart-math.probe.mjs",
    "probe:charts-motion": "node --experimental-strip-types tools/probes/charts-motion.probe.mjs",
    "probe:charts-share": "node --experimental-strip-types tools/probes/charts-share.probe.mjs",
    "probe:charts-roving": "node --experimental-strip-types tools/probes/charts-roving.probe.mjs",
    "probe:charts-format": "node --experimental-strip-types tools/probes/charts-format.probe.mjs",
    "probe:charts-scale": "node --experimental-strip-types tools/probes/charts-scale.probe.mjs",
    "probe:charts-summary": "node --experimental-strip-types tools/probes/charts-summary.probe.mjs",
    "probe:charts-skeleton": "node --experimental-strip-types tools/probes/charts-skeleton.probe.mjs",
    "publish:manual": "npm run build:lib && npm publish ./dist/ds",
    "release:beta": "node tools/release-beta.mjs",
    "release:major": "npm version major -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:patch": "npm version patch -m \"release: %s\"",
    "start": "npm run dev:docs",
    "version": "node tools/prepare-release-commit.mjs",
    "watch": "ng build ds --watch --configuration development",
    "compare:docs": "node tools/compare-docs-pixels.mjs",
    "serve:static": "node tools/serve-static.mjs"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "marked": "^18.0.5",
    "ng-packagr": "^21.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "sass": "1.97.3",
    "stylelint": "^17.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "zone.js": "~0.15.0"
  },
  "sideEffects": false
}
