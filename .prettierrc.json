{
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "auto",
  "bracketSpacing": true,
  "arrowParens": "always",
  "bracketSameLine": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular",
        "singleAttributePerLine": true
      }
    }
  ]
}
